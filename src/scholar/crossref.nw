class TestFetchCurrency:
    """Tests for CrossrefClient.fetch_currency via the shared client."""

    def test_no_doi_makes_no_request(self):
        """A missing DOI returns None without calling the API."""
        with patch.object(_client._session, "get") as mock_get:
            assert fetch_currency(None) is None
            mock_get.assert_not_called()

    def test_retracted_work_returns_notices(self):
        """An updated-by entry is normalized onto the result."""
        message = {
            "updated-by": [
                {
                    "DOI": "10.1/retraction",
                    "type": "retraction",
                    "label": "Retraction",
                    "source": "retraction-watch",
                    "updated": {"date-parts": [[2010, 2, 6]]},
                }
            ]
        }
        with patch.object(
            _client._session, "get", return_value=_mock_response(200, message)
        ):
            result = fetch_currency("10.1/work")
        assert result["updated_by"] == [
            {
                "doi": "10.1/retraction",
                "type": "retraction",
                "label": "Retraction",
                "date": "2010-02-06",
                "source": "retraction-watch",
            }
        ]
        assert result["newer_versions"] == []

    def test_clean_work_returns_empty_lists(self):
        """A 200 with no notices is 'checked, clean' (empty lists)."""
        with patch.object(
            _client._session, "get", return_value=_mock_response(200, {})
        ):
            result = fetch_currency("10.1/clean")
        assert result == {"updated_by": [], "newer_versions": []}

    def test_doi_is_url_encoded(self):
        """The DOI's slashes/spaces are percent-encoded in the path."""
        captured = {}

        def fake_get(url, **kwargs):
            captured["url"] = url
            return _mock_response(200, {})

        with patch.object(_client._session, "get", side_effect=fake_get):
            fetch_currency("10.1/a b")
        assert "10.1%2Fa%20b" in captured["url"]

    def test_not_found_returns_none(self):
        """A 404 yields None (undetermined), not an empty result."""
        with patch.object(
            _client._session, "get", return_value=_mock_response(404)
        ):
            assert fetch_currency("10.1/missing") is None

    def test_transport_error_returns_none(self):
        """A raised exception is swallowed into None."""
        with patch.object(
            _client._session, "get", side_effect=Exception("boom")
        ):
            assert fetch_currency("10.1/broken") is None

    def test_result_is_cached(self):
        """A second lookup of the same DOI does not hit the network."""
        with patch.object(
            _client._session, "get", return_value=_mock_response(200, {})
        ) as mock_get:
            fetch_currency("10.1/cached")
            fetch_currency("10.1/cached")
        assert mock_get.call_count == 1
