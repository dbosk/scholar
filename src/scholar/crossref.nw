\subsection{Reducing a paper to a status}

Both the [[verify]] report and the [[enrich]] warnings need the same one-word
summary of a paper's currency, so we define it once here rather than in the CLI.
The order of the checks encodes severity: a retraction outranks a correction,
which outranks mere supersession.  Only once those are ruled out do we
distinguish a checked-clean paper (\enquote{ok}) from one we never managed to
check (\enquote{unknown}), using the [[None]]-versus-empty distinction the
[[Paper]] model preserves for exactly this purpose.

<<module-level currency interface>>=
def currency_status(paper: Paper) -> str:
    """Summarize a paper's currency as one of five status words.

    Returns ``"retracted"``, ``"corrected"``, ``"superseded"``, ``"ok"``
    (checked, no issues), or ``"unknown"`` (never successfully checked).
    """
    if paper.is_retracted:
        return "retracted"
    if paper.is_corrected:
        return "corrected"
    if paper.is_superseded:
        return "superseded"
    if paper.updated_by is None and paper.newer_versions is None:
        return "unknown"
    return "ok"
@

<<test functions>>=
class TestCurrencyStatus:
    """Tests for currency_status precedence and the ok/unknown split."""

    def test_retraction_outranks_correction(self):
        paper = Paper(
            title="T",
            authors=["a"],
            updated_by=[{"type": "retraction"}, {"type": "correction"}],
        )
        assert currency_status(paper) == "retracted"

    def test_checked_clean_is_ok(self):
        paper = Paper(title="T", authors=["a"], updated_by=[], newer_versions=[])
        assert currency_status(paper) == "ok"

    def test_unchecked_is_unknown(self):
        paper = Paper(title="T", authors=["a"])
        assert currency_status(paper) == "unknown"

    def test_superseded_when_only_newer_versions(self):
        paper = Paper(
            title="T",
            authors=["a"],
            updated_by=[],
            newer_versions=[{"doi": "10.1/v2", "relation": "is-preprint-of"}],
        )
        assert currency_status(paper) == "superseded"
