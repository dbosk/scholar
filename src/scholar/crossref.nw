\subsection{Normalizing superseding-version relations}

Crossref's [[relation]] map can express many relationship types; we only care
about those that mean a newer, more canonical version of this work exists.  The
clearest is [[is-preprint-of]] (this preprint has a published version);
[[is-version-of]] captures the more general case of a work that is a particular
version of a canonical record.  We read only relations whose identifier is a
DOI, since a bare DOI is what makes the newer version actionable for the reader.

<<constants>>=
# Crossref relation types that mean a newer/canonical version exists.
SUPERSEDING_RELATIONS = ("is-preprint-of", "is-version-of")
@

<<currency normalization helpers>>=
def _normalize_newer_versions(message: dict) -> list[dict]:
    """Extract DOIs of newer/canonical versions from the relation map."""
    relation = message.get("relation") or {}
    versions = []
    for rel_type in SUPERSEDING_RELATIONS:
        for entry in relation.get(rel_type) or []:
            if entry.get("id-type") == "doi" and entry.get("id"):
                versions.append({"doi": entry["id"], "relation": rel_type})
    return versions
@

<<test functions>>=
class TestNormalizeNewerVersions:
    """Tests for _normalize_newer_versions."""

    def test_preprint_relation_is_extracted(self):
        message = {
            "relation": {
                "is-preprint-of": [{"id-type": "doi", "id": "10.1/published"}]
            }
        }
        assert _normalize_newer_versions(message) == [
            {"doi": "10.1/published", "relation": "is-preprint-of"}
        ]

    def test_non_doi_relation_is_ignored(self):
        message = {
            "relation": {
                "is-preprint-of": [{"id-type": "url", "id": "http://x"}]
            }
        }
        assert _normalize_newer_versions(message) == []

    def test_no_relation_is_empty(self):
        assert _normalize_newer_versions({}) == []
