\subsection{Normalizing update notices}

Each [[updated-by]] entry becomes a flat dictionary with the fields the CLI and
the [[Paper]] predicates need.  We default a missing [[type]] to
\enquote{update} rather than dropping the entry: a notice with no stated type is
still a notice, and silently discarding it could hide a real retraction.

<<currency normalization helpers>>=
def _normalize_updated_by(message: dict) -> list[dict]:
    """Flatten a Crossref message's update notices into simple dicts."""
    notices = []
    for entry in message.get("updated-by") or []:
        notices.append(
            {
                "doi": entry.get("DOI"),
                "type": entry.get("type") or "update",
                "label": entry.get("label"),
                "date": _format_notice_date(entry.get("updated")),
                "source": entry.get("source"),
            }
        )
    return notices
@

<<test functions>>=
class TestNormalizeUpdatedBy:
    """Tests for _normalize_updated_by."""

    def test_missing_type_defaults_to_update(self):
        """An entry without a type is kept, typed as 'update'."""
        notices = _normalize_updated_by({"updated-by": [{"DOI": "10.1/n"}]})
        assert notices == [
            {
                "doi": "10.1/n",
                "type": "update",
                "label": None,
                "date": None,
                "source": None,
            }
        ]

    def test_no_updates_is_empty(self):
        assert _normalize_updated_by({}) == []
