class TestThemeGrouping:
    def test_theme_grouping_prompt_includes_all_themes(self):
        theme_counts = {"security": 5, "privacy": 3, "authentication": 1}
        prompt = build_theme_grouping_prompt(theme_counts, "Test context")

        assert "security (5 papers)" in prompt
        assert "privacy (3 papers)" in prompt
        assert "authentication (1 paper)" in prompt
        assert "Test context" in prompt

    def test_parse_grouping_response_extracts_groups(self):
        response = """
        ===GROUPING_START===
        EXPLANATION: Security and authentication are closely related.
        GROUP: Security & Auth | security, authentication | Both deal with access control
        STANDALONE: privacy | Distinct topic about data protection
        ===GROUPING_END===
        """
        result = parse_theme_grouping_response(response)

        assert result.explanation == "Security and authentication are closely related."
        assert len(result.groups) == 1
        assert result.groups[0].merged_name == "Security & Auth"
        assert result.groups[0].themes == ["security", "authentication"]
        assert "access control" in result.groups[0].reasoning
        assert "privacy" in result.standalone

    def test_parse_grouping_response_handles_no_markers(self):
        response = "Sorry, I couldn't analyze the themes."
        result = parse_theme_grouping_response(response)

        assert result.groups == []
        assert "Could not parse" in result.explanation
