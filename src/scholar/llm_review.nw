\subsubsection{Theme grouping function}

<<llm review synthesis>>=
def suggest_theme_groups(
    theme_counts: dict[str, int],
    research_context: str | None = None,
    model_selection=None,
    *,
    model_id: str | None = None,
) -> ThemeGroupingResult:
    """Use LLM to suggest theme groupings.

    Args:
        theme_counts: Dict mapping theme names to paper counts.
        research_context: The research question context.
        model_selection: LLM model selection policy for analytic steps.
        model_id: Deprecated compatibility alias for selecting the analytic model.

    Returns:
        ThemeGroupingResult with suggested groupings.
    """
    try:
        import llm as llm_module
    except ImportError:
        raise ImportError(
            "The 'llm' package is required for theme grouping. "
            "Install it with: pip install llm"
        )

    from scholar.utils import select_model_id

    llm = globals().get("llm", llm_module)

    selected_model_id = model_id
    if selected_model_id is None and model_selection is not None:
        selected_model_id = select_model_id(model_selection, "analytic")

    model = (
        llm.get_model(selected_model_id)
        if selected_model_id
        else llm.get_model()
    )

    prompt = build_theme_grouping_prompt(theme_counts, research_context)
    response = model.prompt(prompt)

    return parse_theme_grouping_response(response.text())
