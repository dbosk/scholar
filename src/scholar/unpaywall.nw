class TestFetchOA:
    """Tests for UnpaywallClient.fetch_oa via the shared client."""

    def test_no_doi_makes_no_request(self):
        """A missing DOI returns None without calling the API."""
        with patch.object(_client._session, "get") as mock_get:
            assert fetch_oa(None) is None
            mock_get.assert_not_called()

    def test_unconfigured_makes_no_request(self, monkeypatch):
        """Without a contact email the lookup is a silent no-op."""
        monkeypatch.delenv("SCHOLAR_EMAIL")
        assert not is_configured()
        with patch.object(_client._session, "get") as mock_get:
            assert fetch_oa("10.1/any") is None
            mock_get.assert_not_called()

    def test_email_is_sent_as_parameter(self):
        """The configured email travels in the query string."""
        with patch.object(
            _client._session, "get", return_value=_mock_response(200, {})
        ) as mock_get:
            fetch_oa("10.1/work")
        assert mock_get.call_args.kwargs["params"] == {
            "email": "tests@example.org"
        }

    def test_open_work_returns_best_location(self):
        """Status and best-location fields are normalized onto the result."""
        data = {
            "is_oa": True,
            "oa_status": "green",
            "best_oa_location": {
                "url": "https://arxiv.org/abs/1234",
                "url_for_pdf": "https://arxiv.org/pdf/1234",
                "url_for_landing_page": "https://arxiv.org/abs/1234",
                "host_type": "repository",
                "version": "submittedVersion",
                "license": "cc-by",
            },
            "oa_locations": [],
        }
        with patch.object(
            _client._session, "get", return_value=_mock_response(200, data)
        ):
            result = fetch_oa("10.1/work")
        assert result == {
            "is_oa": True,
            "oa_status": "green",
            "oa_url": "https://arxiv.org/abs/1234",
            "pdf_url": "https://arxiv.org/pdf/1234",
            "host_type": "repository",
            "version": "submittedVersion",
            "license": "cc-by",
        }

    def test_closed_work_is_checked_not_unknown(self):
        """A closed record yields a result (status 'closed'), not None."""
        data = {"is_oa": False, "oa_status": "closed",
                "best_oa_location": None, "oa_locations": []}
        with patch.object(
            _client._session, "get", return_value=_mock_response(200, data)
        ):
            result = fetch_oa("10.1/closed")
        assert result["is_oa"] is False
        assert result["oa_status"] == "closed"
        assert result["pdf_url"] is None
        assert result["oa_url"] is None

    def test_doi_is_url_encoded(self):
        """The DOI's slashes and reserved characters are percent-encoded."""
        captured = {}

        def fake_get(url, **kwargs):
            captured["url"] = url
            return _mock_response(200, {})

        with patch.object(_client._session, "get", side_effect=fake_get):
            fetch_oa("10.1/a#b")
        assert captured["url"].endswith("/10.1%2Fa%23b")

    def test_not_found_returns_none_and_is_cached(self):
        """A 404 yields None and is not retried."""
        with patch.object(
            _client._session, "get", return_value=_mock_response(404)
        ) as mock_get:
            assert fetch_oa("10.1/missing") is None
            assert fetch_oa("10.1/missing") is None
        assert mock_get.call_count == 1

    def test_rate_limit_returns_none_and_is_not_cached(self):
        """A 429 yields None but leaves the DOI retryable."""
        with patch.object(
            _client._session, "get", return_value=_mock_response(429)
        ) as mock_get:
            assert fetch_oa("10.1/busy") is None
            assert fetch_oa("10.1/busy") is None
        assert mock_get.call_count == 2

    def test_transport_error_returns_none(self):
        """A raised exception is swallowed into None."""
        with patch.object(
            _client._session, "get", side_effect=Exception("boom")
        ):
            assert fetch_oa("10.1/broken") is None

    def test_result_is_cached(self):
        """A second lookup of the same DOI does not hit the network."""
        with patch.object(
            _client._session, "get", return_value=_mock_response(200, {})
        ) as mock_get:
            fetch_oa("10.1/cached")
            fetch_oa("10.1/cached")
        assert mock_get.call_count == 1
