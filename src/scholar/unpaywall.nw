\subsection{Annotating a batch of papers}

The batch form exists for callers that hold a whole session and want a progress
bar; it is a loop over [[annotate_paper]] with the same
[[progress_callback(done, total)]] contract as the Crossref batch annotator,
so the CLI can drive both from one progress display.

<<module-level oa interface>>=
def annotate_papers(
    papers: list[Paper], progress_callback=None
) -> list[Paper]:
    """Return copies of ``papers`` annotated with Unpaywall open-access data.

    Papers whose DOI cannot be resolved are returned unchanged.
    ``progress_callback(done, total)`` is invoked after each paper if given.
    """
    annotated = []
    total = len(papers)
    for index, paper in enumerate(papers):
        annotated.append(annotate_paper(paper))
        if progress_callback:
            progress_callback(index + 1, total)
    return annotated
@

<<test functions>>=
class TestAnnotatePapers:
    """Tests for annotate_papers."""

    def test_preserves_order_and_reports_progress(self):
        with_doi = Paper(title="A", authors=["x"], doi="10.1/a")
        without_doi = Paper(title="B", authors=["y"])
        seen = []
        data = {"is_oa": False, "oa_status": "closed"}
        with patch.object(
            _client._session, "get", return_value=_mock_response(200, data)
        ):
            out = annotate_papers(
                [with_doi, without_doi],
                progress_callback=lambda d, t: seen.append((d, t)),
            )
        assert [p.title for p in out] == ["A", "B"]
        assert out[0].oa_status == "closed"
        assert out[1].oa_status is None
        assert seen == [(1, 2), (2, 2)]
