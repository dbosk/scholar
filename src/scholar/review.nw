class TestReportGeneration:
    """Tests for LaTeX and CSV report generation."""

    def test_csv_report_includes_llm_columns(self, tmp_path):
        """CSV report includes LLM review metadata columns."""
        session = ReviewSession(
            query="test",
            providers=["test"],
            timestamp=datetime.now(),
        )
        session.decisions = [
            ReviewDecision(
                paper=Paper(title="Human", authors=["A"], year=2024),
                provider="test",
                status=DecisionStatus.KEPT,
                tags=["ml"],
                source=ReviewSource.HUMAN,
            ),
            ReviewDecision(
                paper=Paper(title="LLM unreviewed", authors=["B"], year=2024),
                provider="test",
                status=DecisionStatus.KEPT,
                source=ReviewSource.LLM_UNREVIEWED,
                llm_confidence=0.9,
            ),
            ReviewDecision(
                paper=Paper(title="LLM confirmed", authors=["C"], year=2024),
                provider="test",
                status=DecisionStatus.KEPT,
                source=ReviewSource.LLM_REVIEWED,
                is_example=False,
                llm_confidence=0.8,
            ),
            ReviewDecision(
                paper=Paper(title="LLM changed", authors=["D"], year=2024),
                provider="test",
                status=DecisionStatus.DISCARDED,
                tags=["off-topic"],
                source=ReviewSource.LLM_REVIEWED,
                is_example=True,
                llm_confidence=0.2,
            ),
        ]

        output_path = tmp_path / "report.csv"
        generate_csv_report(session, output_path)

        content = output_path.read_text()
        assert "decision_source" in content
        assert "llm_review_outcome" in content
        assert "llm_change_direction" in content
        assert "human" in content
        assert "unreviewed" in content
        assert "confirmed" in content
        assert "changed" in content
        assert "kept->discarded" in content

