@

The table itself follows the conventions of the appendix it is meant for:
a [[longtable]] with a repeated header and a \enquote{continued} footer,
set in [[\footnotesize]] so four columns fit, with a caption that states
the counts per category so the reader gets the outcome before the rows.
Both the caption and the labels are localised; the label argument becomes
the [[\label]] the surrounding text refers to.

A topic-driven session can hold thousands of records, and a table of all
of them runs to dozens of pages that say \enquote{false hit} over and
over.  [[bearing_only]] therefore lists only the rows that bear on the
claim---cited, supporting, qualifying---and moves the adjacent,
off-topic and unclassified records into the caption as counts, so the
appendix still accounts for every record without printing it.

<<review report generation>>=
def build_audit_table_latex(
    session: ReviewSession,
    *,
    label: str,
    lang: str = "en",
    track: str | None = None,
    theme_names: dict[str, str] | None = None,
    bearing_only: bool = False,
) -> list[str]:
    """Build the audit longtable as LaTeX lines."""
    if lang not in AUDIT_STRINGS:
        raise ValueError(f"Unsupported language: {lang}")
    strings = AUDIT_STRINGS[lang]
    rows = collect_audit_rows(
        session, theme_names=theme_names or {}, strings=strings
    )
    counts = {
        order: sum(1 for r in rows if r.order == order) for order in range(6)
    }
    if bearing_only:
        template = strings["bearing"]
        rows = [r for r in rows if r.order <= AUDIT_ORDER_BEARING]
    else:
        template = strings["caption"]
    not_listed = ""
    if bearing_only and counts[AUDIT_ORDER_OTHER]:
        not_listed = strings["not_listed_other"].format(
            other=counts[AUDIT_ORDER_OTHER]
        )
    caption = template.format(
        track=f", {escape_latex(track)}" if track else "",
        session=escape_latex(session.name or session.query),
        n=sum(counts.values()),
        cited=counts[0],
        supports=counts[1],
        qualifies=counts[2],
        adjacent=counts[3],
        offtopic=counts[4],
        not_listed=not_listed,
    )
    header = (
        f"{strings['title']} & {strings['year']} & "
        f"{strings['provider']} & {strings['reason']} \\\\"
    )
    lines = [
        r"\begingroup\footnotesize",
        r"\begin{longtable}{@{}%",
        r"  >{\raggedright\arraybackslash}p{0.44\textwidth}c%",
        r"  >{\raggedright\arraybackslash}p{0.13\textwidth}%",
        r"  >{\raggedright\arraybackslash}p{0.26\textwidth}@{}}",
        f"\\caption{{{caption}}}\\label{{tab:{label}}}\\\\",
        r"\toprule",
        header,
        r"\midrule",
        r"\endfirsthead",
        "\\multicolumn{4}{@{}l}{\\emph{\\tablename~\\thetable{} "
        f"{strings['continued']}}}}}\\\\",
        r"\toprule",
        header,
        r"\midrule",
        r"\endhead",
        f"\\midrule \\multicolumn{{4}}{{r@{{}}}}"
        f"{{\\emph{{{strings['continued_next']}}}}}\\\\",
        r"\endfoot",
        r"\bottomrule",
        r"\endlastfoot",
    ]
    for row in rows:
        providers = ", ".join(row.providers)
        lines.append(
            f"{row.title} & {row.year} & {providers} & {row.reason} \\\\"
        )
    lines.extend([r"\end{longtable}", r"\endgroup"])
    return lines


AUDIT_TABLE_PACKAGES: list[str] = [
    r"\usepackage{longtable}",
    r"\usepackage{booktabs}",
    r"\usepackage{array}",
]


def generate_audit_table(
    session: ReviewSession,
    output_path: Path,
    *,
    label: str,
    lang: str = "en",
    track: str | None = None,
    theme_names: dict[str, str] | None = None,
    bearing_only: bool = False,
) -> None:
    """Write the audit table for `session` as a LaTeX fragment."""
    body = build_audit_table_latex(
        session, label=label, lang=lang, track=track,
        theme_names=theme_names, bearing_only=bearing_only,
    )
    lines = latex_fragment(
        body,
        packages=AUDIT_TABLE_PACKAGES,
        generator="scholar sessions export -f table",
    )
    output_path.write_text("\n".join(lines) + "\n")
