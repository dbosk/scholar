The same paper often arrives from several providers, sometimes with and
sometimes without a DOI, so a session may hold it more than once. The
audit table is about papers, not records: rows are merged on title and
year, the providers are joined, and if any of the merged records was kept
that decision wins, because a kept paper is cited whatever the other
providers' copies were classified as. Titles are truncated before
escaping so the cut cannot land inside an escape sequence.

<<review report generation>>=
def collect_audit_rows(
    session: ReviewSession,
    *,
    theme_names: dict[str, str],
    strings: dict[str, str],
) -> list[AuditRow]:
    """Merge the session's decisions into sorted audit rows."""
    rows: dict[tuple[str, str], AuditRow] = {}
    for decision in session.decisions:
        paper = decision.paper
        title = paper.title or ""
        year = str(paper.year) if paper.year else ""
        key = (title.strip().lower(), year)
        provider = PROVIDER_SHORT_NAMES.get(
            decision.provider, decision.provider
        )
        reason, order = audit_reason(
            decision, theme_names=theme_names, strings=strings
        )
        row = rows.get(key)
        if row is None:
            rows[key] = AuditRow(
                title=escape_latex(title[:AUDIT_TITLE_LENGTH]),
                year=year,
                providers=[provider] if provider else [],
                status=decision.status,
                reason=reason,
                order=order,
            )
            continue
        if provider and provider not in row.providers:
            row.providers.append(provider)
        if (
            decision.status == DecisionStatus.KEPT
            and row.status != DecisionStatus.KEPT
        ):
            row.status, row.reason, row.order = decision.status, reason, order
    return sorted(rows.values(), key=lambda r: (r.order, r.title.lower()))
@

