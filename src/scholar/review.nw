    def test_report_includes_llm_agreement_and_changes(self, tmp_path):
        """Report includes LLM confirmed/changed counts when LLM used."""
        paper_confirmed = Paper(
            title="LLM confirmed", authors=["A"], year=2024
        )
        paper_changed_to_kept = Paper(
            title="LLM changed to kept", authors=["B"], year=2024
        )
        paper_changed_to_discarded = Paper(
            title="LLM changed to discarded", authors=["C"], year=2024
        )

        session = ReviewSession(
            query="test",
            providers=["test"],
            timestamp=datetime.now(),
        )
        session.decisions = [
            # Confirmed LLM decision
            ReviewDecision(
                paper=paper_confirmed,
                provider="test",
                status=DecisionStatus.KEPT,
                source=ReviewSource.LLM_REVIEWED,
                is_example=False,
            ),
            # Changed from the LLM's classification (tracked via is_example)
            ReviewDecision(
                paper=paper_changed_to_kept,
                provider="test",
                status=DecisionStatus.KEPT,
                source=ReviewSource.LLM_REVIEWED,
                is_example=True,
            ),
            ReviewDecision(
                paper=paper_changed_to_discarded,
                provider="test",
                status=DecisionStatus.DISCARDED,
                tags=["off-topic"],
                source=ReviewSource.LLM_REVIEWED,
                is_example=True,
            ),
        ]

        output_path = tmp_path / "report.tex"
        generate_latex_report(session, output_path)

        content = output_path.read_text()
        assert r"\item[LLM confirmed] 1" in content
        assert r"\item[LLM changed] 2" in content
        assert r"\item[LLM changed (kept->discarded)] 1" in content
        assert r"\item[LLM changed (discarded->kept)] 1" in content

