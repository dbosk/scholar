\subsection{Summary tables}

The overview tables use [[\citetitle]] rather than the raw title so that
biblatex owns the formatting and the title stays consistent with the
bibliography entry. The matrix table has one column per tag, which does
not fit a page with horizontal headers, hence the rotated headers; a
[[\checkmark]] marks membership because an empty cell reads more easily
than a word in a dense grid.

<<review report generation>>=
def format_list_table(
    decisions: list[ReviewDecision],
    cite_key: Callable[[ReviewDecision], str],
    tag_label: str,
) -> list[str]:
    """Generate a longtable with Title, Year and tag columns."""
    lines = [
        r"\begin{longtable}{>{\raggedright\arraybackslash}p{0.55\textwidth}"
        r"c>{\raggedright\arraybackslash}p{0.25\textwidth}}",
        r"\toprule",
        f"\\textbf{{Title}} & \\textbf{{Year}} & \\textbf{{{tag_label}}} \\\\",
        r"\midrule",
        r"\endhead",
        r"\bottomrule",
        r"\endlastfoot",
    ]
    for decision in decisions:
        year = decision.paper.year or "---"
        tags = ", ".join(escape_latex(t) for t in sorted(decision.tags))
        lines.append(
            f"\\citetitle{{{cite_key(decision)}}} & {year} & {tags} \\\\"
        )
    lines.append(r"\end{longtable}")
    return lines


def format_matrix_table(
    decisions: list[ReviewDecision],
    cite_key: Callable[[ReviewDecision], str],
    tags: set[str],
) -> list[str]:
    """Generate a papers-by-tags cross-tabulation as a longtable."""
    sorted_tags = sorted(tags)
    num_tags = len(sorted_tags)

    # Build column spec: title column + one centered column per tag
    col_spec = r">{\raggedright\arraybackslash}p{0.4\textwidth}" + "c" * num_tags

    lines = [
        f"\\begin{{longtable}}{{{col_spec}}}",
        r"\toprule",
    ]

    # Header row with rotated tag names
    header_cells = [r"\textbf{Title}"]
    for tag in sorted_tags:
        header_cells.append(f"\\rotatebox{{90}}{{{escape_latex(tag)}}}")
    lines.append(" & ".join(header_cells) + r" \\")
    lines.append(r"\midrule")
    lines.append(r"\endhead")
    lines.append(r"\bottomrule")
    lines.append(r"\endlastfoot")

    # Data rows
    for decision in decisions:
        row_cells = [f"\\citetitle{{{cite_key(decision)}}}"]
        for tag in sorted_tags:
            if decision.has_tag(tag):
                row_cells.append(r"$\checkmark$")
            else:
                row_cells.append("")
        lines.append(" & ".join(row_cells) + r" \\")

    lines.append(r"\end{longtable}")
    return lines
@

