\subsection{CSV report}

The CSV carries every field the other artefacts summarise, including the
LLM provenance columns, so that a spreadsheet or a script can recompute
any of the tables above.

<<review report generation>>=
def generate_csv_report(session: ReviewSession, output_path: Path) -> None:
    """
    Generate a CSV report of the review session.

    The CSV includes all papers (kept and discarded) with columns:
    - status: kept/discarded/pending
    - title, authors, year, venue, doi, url
    - tags: semicolon-separated list of themes/motivations
    - abstract: full abstract text
    - provider: search provider that returned the paper
    - decision_source: where the keep/discard decision originated
    - llm_confidence: 0.0-1.0 confidence for LLM decisions (if available)
    - llm_review_outcome: human/unreviewed/confirmed/changed
    - llm_change_direction: kept->discarded or discarded->kept (only for changed)

    Args:
        session: The ReviewSession to report on.
        output_path: Path for the .csv file.
    """
    import csv

    def llm_review_outcome(decision: ReviewDecision) -> str:
        if decision.source == ReviewSource.HUMAN:
            return "human"
        if decision.source == ReviewSource.LLM_UNREVIEWED:
            return "unreviewed"
        if decision.source == ReviewSource.LLM_REVIEWED:
            return "changed" if decision.is_example else "confirmed"
        return ""

    def llm_change_direction(decision: ReviewDecision) -> str:
        if decision.source != ReviewSource.LLM_REVIEWED or not decision.is_example:
            return ""
        if decision.status == DecisionStatus.DISCARDED:
            return "kept->discarded"
        if decision.status == DecisionStatus.KEPT:
            return "discarded->kept"
        return ""

    with open(output_path, "w", newline="", encoding="utf-8") as f:
        writer = csv.writer(f)

        # Header row
        writer.writerow(
            [
                "status",
                "title",
                "authors",
                "year",
                "venue",
                "doi",
                "url",
                "tags",
                "abstract",
                "provider",
                "decision_source",
                "llm_confidence",
                "llm_review_outcome",
                "llm_change_direction",
            ]
        )

        # Write all decisions
        for decision in session.decisions:
            paper = decision.paper
            writer.writerow(
                [
                    decision.status.value,
                    paper.title,
                    "; ".join(paper.authors) if paper.authors else "",
                    paper.year or "",
                    paper.venue or "",
                    paper.doi or "",
                    paper.url or "",
                    "; ".join(decision.tags) if decision.tags else "",
                    paper.abstract or "",
                    decision.provider,
                    decision.source.value,
                    (
                        f"{decision.llm_confidence:.3f}"
                        if decision.llm_confidence is not None
                        else ""
                    ),
                    llm_review_outcome(decision),
                    llm_change_direction(decision),
                ]
            )
