        assert r"\addbibresource{report.bib}" in content
        assert r"\begin{refsection}" not in content
        assert content.rstrip().endswith(r"\end{document}")

    def test_fragment_omits_skeleton_and_writes_bib(self, tmp_path):
        path = tmp_path / "report.tex"
        generate_latex_report(self._session(), path, standalone=False)
        content = path.read_text()
