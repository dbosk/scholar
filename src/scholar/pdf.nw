    def test_doi_redirecting_to_a_pdf(self):
        """A repository DOI may resolve to the PDF itself."""
        pdf = self.page("application/pdf", url="https://repo.example/a.pdf")
        with patch("scholar.pdf.requests.get", return_value=pdf):
            assert resolve_doi_landing("10.1/x") == "https://repo.example/a.pdf"

    def test_candidates_are_lazy_and_distinct(self):
        """Later sources are asked only on demand; repeats are dropped."""
        with patch("scholar.pdf.resolve_doi_unpaywall", return_value="u") as up, \
             patch("scholar.pdf.resolve_doi_s2", return_value="u") as s2, \
             patch("scholar.pdf.resolve_doi_landing", return_value="p") as lp:
            candidates = doi_pdf_candidates("10.1/x")
            assert next(candidates) == ("Unpaywall", "u")
            assert not s2.called and not lp.called
            assert next(candidates) == ("the publisher's page", "p")
            assert s2.called
