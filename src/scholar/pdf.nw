class TestSegmentPassages:
    """Tests for passage segmentation."""

    def test_dehyphenates_across_line_breaks(self):
        pages = [
            "An authen-\nticated encryption scheme provides privacy "
            "and authenticity for every message it protects."
        ]
        passages = segment_passages(pages)
        assert any("authenticated encryption" in p.text for p in passages)

    def test_strips_pdfium_softhyphen_marker(self):
