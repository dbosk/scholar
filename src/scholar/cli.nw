                f"{note.updated_at.strftime('%Y-%m-%d %H:%M')}[/dim]"
            )
            console.print()
            console.print(note.note, markup=False)
            return

    console.print(f"[red]No notes found for paper ID: {escape(paper_id)}[/red]")
    raise typer.Exit(1)


