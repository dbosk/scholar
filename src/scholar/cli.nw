\subsection{Exporting notes back to the [[.bib]]}

[[export]] looks up each entry's note, keeps only its provenance segments, and
rewrites the file.  Discarding personal segments here is what keeps private
prose out of the bibliography.  By default it prints to standard output so the
result can be inspected or piped; [[--in-place]] overwrites the file instead,
and the count goes to standard error so it never corrupts piped output.

<<prov command>>=
@prov_app.command("export")
def prov_export(
    bib_file: Annotated[
        Path,
        typer.Argument(help="BibTeX file to write provenance blocks into."),
    ],
    in_place: Annotated[
        bool,
        typer.Option(
            "--in-place", "-i",
            help="Overwrite the file instead of printing to stdout.",
        ),
    ] = False,
) -> None:
    """
    Export notes' provenance blocks into a .bib file.

    For each entry, the paper's stored block(s) are written above it.
    Personal note text is never emitted. Prints to stdout unless
    --in-place is given.
    """
    from scholar.notes import get_note

    console = Console()
    if not bib_file.exists():
        console.print(f"[red]File not found: {escape(str(bib_file))}[/red]")
        raise typer.Exit(1)

    text = bib_file.read_text(encoding="utf-8")
    entries = _parse_bib_entries(text)

    def blocks_for(entry):
        note = get_note(_paper_from_entry(entry.fields))
        if note is None:
            return []
        return [
            payload
            for kind, payload in _split_note_segments(note.note)
            if kind == "prov"
        ]

    new_text, count = _rewrite_with_blocks(text, entries, blocks_for)
    noun = "entry" if count == 1 else "entries"

    if in_place:
        bib_file.write_text(new_text, encoding="utf-8")
        console.print(
            f"[green]Annotated {count} {noun} in "
            f"{escape(str(bib_file))}[/green]"
        )
    else:
        print(new_text, end="")
        Console(stderr=True).print(
            f"[green]Annotated {count} {noun}[/green]"
        )
@

