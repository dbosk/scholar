            result = runner.invoke(app, ["enrich", name])
        assert result.exit_code == 0, result.stdout
        assert "Open access: 2 of 2 checked papers (2 with PDF link)" in result.stdout
        assert "Enriched 1 papers" in result.stdout
        # Reload in a fresh registry: the process-wide one still holds the
