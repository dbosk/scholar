        with isolated_registry():
            saved = load_session(name)
        by_doi = {d.paper.doi: d.paper for d in saved.decisions}
        assert by_doi["10.1/bare"].pdf_url == "https://j/10.1/bare.pdf"
        assert by_doi["10.1/bare"].oa_status == "gold"
