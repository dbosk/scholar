            "scholar.crossref.annotate_papers", side_effect=annotate
        ):
            result = runner.invoke(app, ["verify", "ptest"])
        assert result.exit_code == 0
        assert "SUPERSEDED" not in result.stdout
        assert "preprint of 10.1/published" in result.stdout
        assert "1 preprint" in result.stdout
