class TestProvidersLimitsCommand:
    """Tests for the providers limits action."""

    def test_limits_shows_declared_limits(self):
        """The ieee row shows its declared 10/s and 200/day limits."""
        result = runner.invoke(app, ["providers", "limits"])
        assert result.exit_code == 0
        assert "ieee" in result.stdout
        assert "10/s" in result.stdout
        assert "200/day" in result.stdout

    def test_limits_shows_persisted_exhaustion(self):
        """A spent quota recorded in the state file shows as exhausted."""
        from scholar import ratelimit
        from scholar.ratelimit import Limits

        ratelimit._LIMITERS.pop("ieee", None)
        limiter = ratelimit.get_limiter(
            "ieee", Limits(per_second=10.0, daily=200)
        )
        limiter.record_limit_hit(
            reason="daily quota exhausted (IEEE)", exhausted_daily=True
        )
        result = runner.invoke(app, ["providers", "limits"])
        assert result.exit_code == 0
        assert "exhausted" in result.stdout
        ratelimit._LIMITERS.pop("ieee", None)

    def test_limits_reset_clears_state(self):
        """--reset deletes the persisted state for the named provider."""
        from scholar import ratelimit
        from scholar.ratelimit import Limits

        ratelimit._LIMITERS.pop("ieee", None)
        ratelimit.get_limiter("ieee", Limits(daily=200)).acquire()
        assert ratelimit.load_state("ieee")["day_count"] == 1
        result = runner.invoke(
            app, ["providers", "limits", "--reset", "ieee"]
        )
        assert result.exit_code == 0
        assert ratelimit.load_state("ieee")["day_count"] == 0
        ratelimit._LIMITERS.pop("ieee", None)
