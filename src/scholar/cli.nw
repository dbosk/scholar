        table.add_column("Authors", max_width=20)
        table.add_column("Year", style="green")
        table.add_column("Session", style="magenta")
        table.add_column("Tags", style="dim")

        for p in papers:
            authors = ", ".join(p["authors"][:2])
            if len(p["authors"]) > 2:
                authors += " et al."
            table.add_row(
                Text((p["title"] or "")[:40]
                     + ("..." if len(p["title"] or "") > 40
                        else "")),
                Text(authors),
                str(p["year"] or ""),
                Text(p["session_name"]),
                Text(", ".join(p["tags"])),
            )

        console.print(table)
        console.print(
            f"\n[dim]{len(papers)} paper(s) with theme "
            f"'{escape(theme)}'[/dim]"
        )
