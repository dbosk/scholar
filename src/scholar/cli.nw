# Minimal module header: imports, Typer apps, and stub completions
from __future__ import annotations
from typing import Optional, Annotated
from pathlib import Path
import typer
from rich.console import Console

app = typer.Typer(help="Scholar CLI")
llm_app = typer.Typer(help="LLM commands")
app.add_typer(llm_app, name="llm")

# Stub completion helpers (safe at import time)
def complete_session_name(ctx=None, args=None, incomplete=""):
    """Safe session name completion stub for import time."""
    return []


def complete_model(ctx=None, args=None, incomplete=""):
    """Safe model completion stub for import time."""
    return []


def complete_synthesis_format(ctx=None, args=None, incomplete=""):
    """Safe output format completion stub for import time."""
    return []


def complete_theme(ctx=None, args=None, incomplete=""):
    """Autocomplete theme labels for sessions (module-level, defensive).

    Accepts different completion callback signatures (Typer/Click varies):
    - (incomplete: str)
    - (ctx, args, incomplete)

    Tries to infer session name from context params, provided args, or
    sys.argv. Never raises; returns an empty list on error.
    """
    try:
        ctx = None
        args = None
        if len(cb_args) == 1:
            incomplete = cb_args[0]
        elif len(cb_args) == 3:
            ctx, args, incomplete = cb_args
        else:
            incomplete = cb_args[-1]
            if len(cb_args) >= 2:
                args = cb_args[0]

        session_name = None
        if ctx and getattr(ctx, "params", None):
            session_name = ctx.params.get("session_name")

        if not session_name and args:
            try:
                if isinstance(args, (list, tuple)):
                    if "synthesize" in args:
                        i = args.index("synthesize")
                        if i + 1 < len(args):
                            session_name = args[i + 1]
                    else:
                        session_name = args[0]
            except Exception:
                session_name = None

        if not session_name:
            import sys
            argv = sys.argv[1:]
            if "synthesize" in argv:
                synth_idx = argv.index("synthesize")
                if synth_idx + 1 < len(argv):
                    session_name = argv[synth_idx + 1]

        if not session_name:
            return []

        from scholar.review import load_session
        s = load_session(session_name)
        if s is None:
            return []

        labels = sorted(list(s.all_themes()))
        if any(not d.tags for d in s.kept_papers):
            labels.append("unthemed")

        return [t for t in labels if t.startswith(incomplete)]
    except Exception:
        return []


@llm_app.command("synthesize")
def llm_synthesize(
    session_name: Annotated[
        str,
        typer.Argument(
            help="Session name to synthesize.",
            autocompletion=complete_session_name,
        ),
    ],
    model: Annotated[
        str | None,
        typer.Option(
            "--model", "-m",
            help="LLM model to use (uses llm default if not specified).",
            autocompletion=complete_model,
        ),
    ] = None,
    output: Annotated[
        Path | None,
        typer.Option(
            "--output", "-o",
            help="Output file path (prints to stdout if not specified).",
        ),
    ] = None,
    output_format: Annotated[
        str,
        typer.Option(
            "--format", "-f",
            help="Output format: markdown or latex.",
            autocompletion=complete_synthesis_format,
        ),
    ] = "markdown",
    max_papers: Annotated[
        int | None,
        typer.Option(
            "--max-papers",
            help="Maximum papers to include (manages token limits).",
        ),
    ] = None,
    dry_run: Annotated[
        bool,
        typer.Option(
            "--dry-run",
            help="Show the prompt without calling LLM.",
        ),
    ] = False,
    themes: Annotated[
        Optional[list[str]],
        typer.Option(
            "--themes", "-t",
            help="Restrict synthesis to these theme names (repeatable). Use 'unthemed' for papers without tags.",
            autocompletion=complete_theme,
        ),
    ] = None,
    interactive: Annotated[
        bool,
        typer.Option(
            "--interactive", "-i",
            help="Interactively select which themes to include (uses questionary).",
        ),
    ] = False,
) -> None:
    """
    Generate a prose literature synthesis from kept papers.

    Creates a coherent narrative explaining how papers in the review
    contribute to answering the research question.
    """
    from scholar.review import load_session
    from scholar.llm_review import generate_literature_synthesis

    console = Console()
    session = load_session(session_name)

    if session is None:
        console.print(f"[red]Session not found: {session_name}[/red]")
        raise typer.Exit(1)

    # Validate output format
    if output_format not in ("markdown", "latex"):
        console.print(
            f"[red]Invalid format: {output_format}. "
            "Use 'markdown' or 'latex'.[/red]"
        )
        raise typer.Exit(1)

    # Collect available themes for the session
    available_themes = sorted(list(session.all_themes()))
    has_untagged = any(not d.tags for d in session.kept_papers)
    available_theme_labels = available_themes + (["unthemed"] if has_untagged else [])

    # Helper: map 'unthemed' label to internal None, and identity otherwise
    def _label_to_internal(label: str) -> str | None:
        return None if label == "unthemed" else label

    # Determine candidate themes for interactive prompt based on --themes
    valid_themes_from_cli: list[str] | None = None
    if themes:
        normalized = [t.strip() for t in themes if t and t.strip()]
        valid = [t for t in normalized if t in available_theme_labels]
        invalid = [t for t in normalized if t not in available_theme_labels]
        if invalid:
            console.print(f"[yellow]Warning: unknown themes ignored: {', '.join(invalid)}[/yellow]")
        if not valid:
            console.print(f"[red]No valid themes provided via --themes. Available: {', '.join(available_theme_labels)}[/red]")
            raise typer.Exit(1)
        valid_themes_from_cli = valid

    # Interactive selection
    selected_theme_labels: list[str] | None = None
    if interactive:
        prompt_candidates = valid_themes_from_cli if valid_themes_from_cli is not None else available_theme_labels
        if not prompt_candidates:
            console.print("[red]No themes available for selection.[/red]")
            raise typer.Exit(1)

        # Lazy import questionary so interactive mode is optional at runtime
        try:
            import questionary
        except Exception:
            raise ImportError("Interactive mode requires the 'questionary' package.")

        answer = questionary.checkbox(
            message="Select themes to include in synthesis (space to toggle, ENTER to accept):",
            choices=prompt_candidates,
        ).ask()
        # None or empty means abort
        if not answer:
            console.print("[red]No themes selected; aborting.[/red]")
            raise typer.Exit(1)
        selected_theme_labels = answer
    else:
        if valid_themes_from_cli is not None:
            selected_theme_labels = valid_themes_from_cli
        else:
            selected_theme_labels = None  # means include all

    # Map selected labels to internal representation (None for unthemed)
    backend_themes: list[str | None] | None
    if selected_theme_labels is None:
        backend_themes = None
    else:
        backend_themes = [_label_to_internal(lb) for lb in selected_theme_labels]

    try:
        result = generate_literature_synthesis(
            session=session,
            model_id=model,
            output_format=output_format,
            max_papers=max_papers,
            dry_run=dry_run,
            themes=backend_themes,
        )

        if dry_run:
            console.print("[bold]Prompt (dry run):[/bold]")
            console.print(result)
            return

        # Output the synthesis
        synthesis_text = result.synthesis

        if output:
            output.write_text(synthesis_text)
            console.print(f"[green]Synthesis written to {output}[/green]")
            console.print(f"  Papers: {result.paper_count}")
            console.print(f"  Themes: {', '.join(result.themes)}")
            console.print(f"  Model: {result.model_id}")
        else:
            # Print to stdout
            console.print(synthesis_text)

    except ValueError as e:
        console.print(f"[red]Error: {e}[/red]")
        raise typer.Exit(1)
    except ImportError as e:
        console.print(f"[red]{e}[/red]")
        raise typer.Exit(1)
