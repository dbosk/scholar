        )
        assert result.exit_code == 0
        assert "p.1" in result.stdout
        assert "authenticated encryption" in result.stdout

    def test_quote_json_output(self, tmp_path, monkeypatch):
        import json

        pdf_path = tmp_path / "p.pdf"
        pdf_path.write_bytes(b"%PDF-1.4")
        monkeypatch.setattr("scholar.pdf.get_pdf", lambda *a, **k: pdf_path)
        monkeypatch.setattr(
            "scholar.pdf.extract_pdf_pages",
            lambda path: [
                "An authenticated encryption scheme provides both "
                "confidentiality and integrity for messages."
            ],
        )
        runner = CliRunner()
        result = runner.invoke(
            app,
            [
                "pdf",
                "quote",
                "https://x/p.pdf",
                "--claim",
                "authenticated encryption confidentiality integrity",
                "--no-llm",
                "--json",
