Let's verify the check action: offline mode never touches the network, an
all-healthy fleet exits zero, and a rejected key both names the environment
variable and flips the exit code---that gate behaviour is the point of the
command:

<<test functions>>=
class TestProvidersCheckCommand:
    """Tests for the providers check action."""

    def test_check_offline_makes_no_requests(self):
        """--offline reports configuration without any HTTP request."""
        with patch("scholar.providers.requests.get") as mock_get:
            result = runner.invoke(app, ["providers", "check", "--offline"])

            mock_get.assert_not_called()
        assert result.exit_code == 0
        assert "not checked" in result.stdout

    def test_check_all_ok_exits_zero(self):
        """A healthy fleet exits zero."""
        from scholar.providers import ProviderHealth

        def fake_check(provider, live=True):
            return ProviderHealth(provider.name, True, "ok")

        with patch(
            "scholar.providers.check_provider", side_effect=fake_check
        ):
            result = runner.invoke(app, ["providers", "check"])

        assert result.exit_code == 0
        assert "ok" in result.stdout

    def test_check_key_rejected_exits_one(self):
        """A rejected key names its env var and makes the gate fail."""
        from scholar.providers import ProviderHealth

        def fake_check(provider, live=True):
            if provider.name == "s2":
                return ProviderHealth(
                    provider.name, True, "key rejected",
                    "HTTP 403 -- check or replace S2_API_KEY",
                )
            return ProviderHealth(provider.name, True, "ok")

        with patch(
            "scholar.providers.check_provider", side_effect=fake_check
        ):
            result = runner.invoke(app, ["providers", "check"])

        assert result.exit_code == 1
        assert "key rejected" in result.stdout
        assert "S2_API_KEY" in result.stdout

    def test_check_not_configured_exits_zero(self):
        """Missing optional keys are a normal state, not a failure."""
        from scholar.providers import ProviderHealth

        def fake_check(provider, live=True):
            return ProviderHealth(
                provider.name, False, "not configured",
                "required API key missing",
            )

        with patch(
            "scholar.providers.check_provider", side_effect=fake_check
        ):
            result = runner.invoke(app, ["providers", "check"])

        assert result.exit_code == 0
        assert "not configured" in result.stdout

    def test_check_quota_exhausted_exits_zero(self):
        """A spent quota is informational, not a gate failure."""
        from scholar.providers import ProviderHealth

        def fake_check(provider, live=True):
            if provider.name == "ieee":
                return ProviderHealth(
                    provider.name, True, "quota exhausted",
                    "daily quota spent (200/200 requests)",
                )
            return ProviderHealth(provider.name, True, "ok")

        with patch(
            "scholar.providers.check_provider", side_effect=fake_check
        ):
            result = runner.invoke(app, ["providers", "check"])

        assert result.exit_code == 0
        assert "exhausted" in result.stdout
