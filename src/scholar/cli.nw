@llm_app.command("synthesize")
def llm_synthesize(
    session_name: Annotated[
        str,
        typer.Argument(
            help="Session name to synthesize.",
            autocompletion=complete_session_name,
        ),
    ],
    model: Annotated[
        str | None,
        typer.Option(
            "--model", "-m",
            help="Base LLM model to use (uses llm default if not specified).", 
            autocompletion=complete_model,
        ),
    ] = None,
    model_analytic: Annotated[
        str | None,
        typer.Option(
            "--model-analytic",
            help="Override -m for analytic tasks (theme grouping).",
            autocompletion=complete_model,
        ),
    ] = None,
    model_writing: Annotated[
        str | None,
        typer.Option(
            "--model-writing",
            help="Override -m for writing tasks (synthesis generation).",
            autocompletion=complete_model,
        ),
    ] = None,
    output: Annotated[
        Path | None,
        typer.Option(
            "--output", "-o",
            help="Output file path (prints to stdout if not specified).",
        ),
    ] = None,
    output_format: Annotated[
        str,
        typer.Option(
            "--format", "-f",
            help="Output format: markdown or latex.",
            autocompletion=complete_synthesis_format,
        ),
    ] = "markdown",
    max_papers: Annotated[
        int | None,
        typer.Option(
            "--max-papers",
            help="Maximum papers to include (manages token limits).",
        ),
    ] = None,
    dry_run: Annotated[
        bool,
        typer.Option(
            "--dry-run",
            help="Show the prompt without calling LLM.",
        ),
    ] = False,
    no_enrich: Annotated[
        bool,
        typer.Option(
            "--no-enrich",
            help="Skip automatic enrichment of papers without abstracts.",
        ),
    ] = False,
    themes: Annotated[
        list[str] | None,
        typer.Option(
            "--themes", "-t",
            help="Theme to include (can be repeated: -t theme1 -t theme2).",
        ),
    ] = None,
    interactive: Annotated[
        bool,
        typer.Option(
            "--interactive", "-i",
            help="Interactively select themes to include.",
        ),
    ] = False,
    suggest_groups: Annotated[
        bool,
        typer.Option(
            "--suggest-groups",
            help="Use LLM to suggest similar themes for grouping.",
        ),
    ] = False,
) -> None:
    """
    Generate a prose literature synthesis from kept papers.

    Creates a coherent narrative explaining how papers in the review
    contribute to answering the research question.

    The output always begins with a "Research Question" section that
    includes provenance (query/provider pairs, timestamp, and review
    statistics), followed by a "Synthesis" section (organized by themes
    when paper tags are present), a "Conclusion", and a deterministic
    reference list.

    For LaTeX output, a full compilable document is produced, including an
    embedded BibTeX file and a biblatex reference section (run biber when
    compiling).

    Requires:
    - At least one kept paper in the session
    - A research context set for the session

    Examples:
        scholar llm synthesize "my review"
        scholar llm synthesize "my review" -o synthesis.md
        scholar llm synthesize "my review" --format latex -o synthesis.tex
        scholar llm synthesize "my review" -t security -t privacy
        scholar llm synthesize "my review" --interactive
        scholar llm synthesize "my review" -i --suggest-groups
    """
    import scholar.review as review
    from scholar.utils import LLMModelSelection, select_model_id
    from scholar.llm_review import (
        generate_literature_synthesis,
        get_session_theme_counts,
    )

    console = Console()
    session = review.load_session(session_name)

    if session is None:
        console.print(f"[red]Session not found: {escape(session_name)}[/red]")
        raise typer.Exit(1)

    # Validate output format
    if output_format not in ("markdown", "latex"):
        console.print(
            f"[red]Invalid format: {output_format}. "
            "Use 'markdown' or 'latex'.[/red]"
        )
        raise typer.Exit(1)

    model_selection = LLMModelSelection(
        base=model,
        analytic=model_analytic,
        writing=model_writing,
    )

    # Determine selected themes and any groupings
    selected_themes, theme_groupings = _resolve_themes(
        session=session,
        themes_option=themes,
        interactive=interactive,
        suggest_groups=suggest_groups,
        model_id=select_model_id(model_selection, "analytic"),
        console=console,
    )

    try:
        result = generate_literature_synthesis(
            session=session,
            model_id=select_model_id(model_selection, "writing"),
            output_format=output_format,
            max_papers=max_papers,
            enrich_missing=not no_enrich,
            dry_run=dry_run,
            selected_themes=selected_themes,
            theme_groupings=theme_groupings,
        )

        if dry_run:
            console.print("[bold]Prompt (dry run):[/bold]")
            console.print(result)
            return

        # Persist any automatic enrichment (abstracts) to disk so later
        # sessions resume already has the enriched data.
        review.save_session(session)

        # Output the synthesis
        synthesis_text = result.synthesis

        if output:
            output.write_text(synthesis_text)
            console.print(
                f"[green]Synthesis written to {escape(str(output))}[/green]"
            )
            console.print(f"  Papers: {result.paper_count}")
            console.print(
                f"  Themes: {', '.join(escape(t) for t in result.themes)}"
            )
            console.print(f"  Model: {result.model_id}")
        else:
            # Print to stdout
            console.print(synthesis_text, markup=False)

    except ValueError as e:
        console.print(f"[red]Error: {escape(str(e))}[/red]")
        raise typer.Exit(1)
    except ImportError as e:
        console.print(f"[red]{escape(str(e))}[/red]")
        raise typer.Exit(1)
