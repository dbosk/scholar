    def test_reports_open_access_and_persists(self, tmp_path, monkeypatch):
        """The OA tally is printed and the new links are saved."""
        from scholar import isolated_registry
        from scholar.review import load_session

        name = self._make_session(tmp_path, monkeypatch)
        monkeypatch.setenv("SCHOLAR_EMAIL", "tests@example.org")
        with patch(
            "scholar.enrich.enrich_papers", side_effect=self._fake_enrich
        ), patch(
            "scholar.crossref.annotate_papers",
            side_effect=self._identity_annotate,
