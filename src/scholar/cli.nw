\subsection{Testing the providers command}

We test that the providers command lists available providers and their
configuration requirements:

<<test functions>>=
class TestProvidersCommand:
    """Tests for the providers command."""

    def test_providers_command_exists(self):
        """The providers command is registered."""
        result = runner.invoke(app, ["providers", "--help"])
        assert result.exit_code == 0
        assert "List available search providers" in result.stdout

    def test_providers_lists_providers(self):
        """The providers command lists available providers."""
        result = runner.invoke(app, ["providers"])
        assert result.exit_code == 0
        # Should show at least these providers
        assert "s2" in result.stdout
        assert "openalex" in result.stdout
        assert "dblp" in result.stdout

    def test_providers_shows_api_info(self):
        """The providers command shows API key information."""
        result = runner.invoke(app, ["providers"])
        assert result.exit_code == 0
        # Should show environment variable names
        assert "S2_API_KEY" in result.stdout
        assert "WOS_EXPANDED_API_KEY" in result.stdout
        assert "IEEE_API_KEY" in result.stdout
        assert "SCOPUS_API_KEY" in result.stdout

    def test_status_column_is_named_configured(self):
        """The status column answers "is this ready to use?" by name.

        Read as "Default", it was taken together with the red "Required"
        in the next column to mean the key was missing, even on rows
        where the key was in fact configured.
        """
        result = runner.invoke(app, ["providers"])
        assert result.exit_code == 0
        assert "Configured" in result.stdout
        assert "Default" not in result.stdout

    def test_env_var_names_are_never_truncated(self):
        """Env vars and URLs must survive intact -- they are meant to be
        copied, and an ellipsized name cannot be acted on."""
        result = runner.invoke(app, ["providers"])
        assert result.exit_code == 0
        assert "WOS_EXPANDED_API_KEY" in result.stdout
        assert "…" not in result.stdout

    def test_urls_survive_folding(self):
        """Folded URLs keep every character.

        Regression test for issue #74: a min_width floor made Rich size
        the table one column-cell wider than the console, and the crop
        to console width silently dropped trailing characters of the
        last column. We reconstruct that column from its x-offset and
        require each documented URL to appear contiguously.
        """
        result = runner.invoke(app, ["providers"])
        assert result.exit_code == 0
        lines = result.stdout.splitlines()
        # The header cell may itself wrap, so anchor on its first word.
        header = next(l for l in lines if "How to Get" in l)
        offset = header.index("How to Get")
        column = "".join(l[offset:].strip() for l in lines)
        for url in (
            "api.semanticscholar.org",
            "developer.clarivate.com",
            "developer.ieee.org",
            "dev.elsevier.com",
        ):
            assert url in column, f"{url} lost characters in rendering"

