\section{LLM-Assisted Review}
\label{sec:llm-commands}

The [[llm]] command group provides LLM-assisted paper classification for
systematic literature reviews. This integrates with Simon Willison's [[llm]]
package for unified access to various language models.

The workflow is:
\begin{enumerate}
\item User reviews some papers manually, tagging them as examples
  (recommended but optional; classification still runs without them,
  warning that quality may suffer, and [[--no-examples]] skips them
  outright for zero-shot classification)
\item LLM classifies remaining papers based on examples
  (or research context alone)
\item User reviews LLM decisions, corrections become new examples
\item Repeat until all papers are classified
\end{enumerate}

\subsection{The llm command group}

<<llm command>>=
llm_app = typer.Typer(
    name="llm",
    help="LLM-assisted paper classification.",
    no_args_is_help=True,
)
app.add_typer(llm_app, name="llm")


@llm_app.command("classify")
def llm_classify(
    session_name: Annotated[
        str,
        typer.Argument(
            help="Session name to classify papers in.",
            autocompletion=complete_session_name,
        ),
    ],
    count: Annotated[
        int,
        typer.Option(
            "--count", "-n",
            help="Number of papers to classify in this batch.",
        ),
    ] = 10,
    model: Annotated[
        str | None,
        typer.Option(
            "--model", "-m",
            help="Base LLM model to use (uses llm default if not specified).",
            autocompletion=complete_model,
        ),
    ] = None,
    model_analytic: Annotated[
        str | None,
        typer.Option(
            "--model-analytic",
            help="Override -m for analytic tasks (classification, query generation).",
            autocompletion=complete_model,
        ),
    ] = None,
    model_writing: Annotated[
        str | None,
        typer.Option(
            "--model-writing",
            help="Override -m for writing tasks (synthesis generation).",
            autocompletion=complete_model,
        ),
    ] = None,
     dry_run: Annotated[
        bool,
        typer.Option(
            "--dry-run",
            help="Show the prompt without calling LLM.",
        ),
    ] = False,
    no_enrich: Annotated[
        bool,
        typer.Option(
            "--no-enrich",
            help="Skip automatic enrichment of papers without abstracts.",
        ),
    ] = False,
    no_examples: Annotated[
        bool,
        typer.Option(
            "--no-examples",
            help="Skip examples entirely for zero-shot classification, "
            "even if some exist.",
        ),
    ] = False,
    full_text: Annotated[
        bool,
        typer.Option(
            "--full-text",
            help="Classify using supporting passages from each paper's full "
            "text, not just the abstract (needs a research context).",
        ),
    ] = False,
) -> None:
    """
    Classify pending papers using LLM.

    Uses human-reviewed papers as training examples when available. Tagged
    examples are recommended (ideally 5+, with at least 1 kept and 1
    discarded) but no longer required: if too few exist, a warning is shown
    and classification proceeds with whatever examples are present. Pass
    --no-examples to skip examples entirely and run zero-shot classification
    using only the research context, even when examples are available.

    With --full-text, supporting passages from each paper's PDF (matched
    against the research context) are added to the prompt, so classification
    can go beyond the abstract.

    Example:
        scholar llm classify "my review" --count 20
        scholar llm classify "my review" --no-examples
        scholar llm classify "my review" --full-text
    """
    import scholar.review as review
    from scholar.review import save_session
    from scholar.utils import LLMModelSelection, select_model_id
    from scholar.llm_review import (
        classify_papers_with_llm,
        apply_llm_decisions,
        get_review_statistics,
    )

    console = Console()
    session = review.load_session(session_name)

    if session is None:
        console.print(f"[red]Session not found: {escape(session_name)}[/red]")
        raise typer.Exit(1)

    model_selection = LLMModelSelection(
        base=model,
        analytic=model_analytic,
        writing=model_writing,
    )

    try:
        result = classify_papers_with_llm(
            session=session,
            count=count,
            model_id=select_model_id(model_selection, "analytic"),
            enrich_missing=not no_enrich,
            dry_run=dry_run,
            require_examples=not no_examples,
            use_fulltext=full_text,
        )

        if dry_run:
            console.print("[bold]Prompt (dry run):[/bold]")
            console.print(result)
            return

        # Apply decisions
        updated = apply_llm_decisions(session, result)

        # Save session
        save_session(session)

        # Show summary
        stats = get_review_statistics(session)
        console.print(f"[green]Classified {len(updated)} papers[/green]")
        console.print(f"  Model: {result.model_id}")
        console.print(f"  LLM unreviewed: {stats['llm_unreviewed']}")
        console.print(f"  Pending: {stats['pending']}")

    except ValueError as e:
        console.print(f"[red]Error: {escape(str(e))}[/red]")
        raise typer.Exit(1)
    except ImportError as e:
        console.print(f"[red]{escape(str(e))}[/red]")
        raise typer.Exit(1)


@llm_app.command("status")
def llm_status(
    session_name: Annotated[
        str,
        typer.Argument(
            help="Session name to show status for.",
            autocompletion=complete_session_name,
        ),
    ],
    output_format: Annotated[
        str,
        typer.Option(
            "--format", "-f",
            help="Output format: table or json.",
            autocompletion=complete_display_format,
        ),
    ] = "table",
) -> None:
    """
    Show LLM review status for a session.

    Displays counts of human decisions, LLM decisions pending review,
    reviewed LLM decisions, and training examples.
    """
    from scholar.review import load_session
    from scholar.llm_review import get_review_statistics

    console = Console()
    session = load_session(session_name)

    if session is None:
        console.print(f"[red]Session not found: {escape(session_name)}[/red]")
        raise typer.Exit(1)

    stats = get_review_statistics(session)

    if output_format == "json":
        print(json.dumps(stats, indent=2))
    else:
        table = Table(
            title=Text(f"LLM Review Status: {session.query}"),
            box=box.ROUNDED,
        )
        table.add_column("Category", style="cyan")
        table.add_column("Count", justify="right")

        table.add_row("Human decisions", str(stats["human"]))
        table.add_row("LLM (unreviewed)", str(stats["llm_unreviewed"]))
        table.add_row("LLM (reviewed)", str(stats["llm_reviewed"]))
        table.add_row("Training examples", str(stats["examples"]))
        table.add_row("Pending", str(stats["pending"]))
        table.add_row("Total", str(stats["total"]), style="bold")

        console.print(table)


@llm_app.command("context")
def llm_context(
    session_name: Annotated[
        str,
        typer.Argument(
            help="Session name.",
            autocompletion=complete_session_name,
        ),
    ],
    context: Annotated[
        str | None,
        typer.Argument(
            help="Research context to set (omit to show current).",
        ),
    ] = None,
) -> None:
    """
    Get or set the research context for LLM classification.

    The research context helps the LLM understand your review criteria.
    It should describe your research question and what makes papers relevant.

    Example:
        scholar llm context "my review" "I'm reviewing papers on ..."
    """
    from scholar.review import load_session, save_session

    console = Console()
    session = load_session(session_name)

    if session is None:
        console.print(f"[red]Session not found: {escape(session_name)}[/red]")
        raise typer.Exit(1)

    if context is None:
        # Show current context
        if session.research_context:
            console.print("[bold]Research context:[/bold]")
            console.print(session.research_context)
        else:
            console.print("[dim]No research context set.[/dim]")
            console.print(
                "[dim]Use: scholar llm context \"session\" \"your context\"[/dim]"
            )
    else:
        # Set context
        session.research_context = context
        save_session(session)
        console.print("[green]Research context updated.[/green]")
@

\subsection{Literature synthesis generation}

Once the review decisions are in place (and we have a research context that
defines the review's overall research question), we can ask the LLM to generate
a narrative synthesis of the kept papers.

A naive approach is to include all kept papers in a single prompt.
This fails for larger reviews because the prompt quickly exceeds the model's
context window.
Instead, we generate the synthesis in multiple rounds:
\begin{enumerate}
\item Generate a focused synthesis subsection for each theme.
\item Generate a conclusion that connects the themes back to the research
  question.
\item Assemble a full report including provenance and references.
\end{enumerate}

The [[--dry-run]] option prints all prompts so the user can inspect what is
sent to the model.

For LaTeX output, the synthesis is a complete compilable document.
The output embeds a BibTeX file and uses [[biblatex]]; compilation therefore
requires running [[biber]].

\paragraph{Theme selection.}
By default, all themes are included in the synthesis.
Users can select specific themes using the [[--themes/-t]] option (which can be
repeated) or the [[--interactive/-i]] flag to present a checklist.

When [[--interactive]] is specified with many themes, the user can optionally
run LLM-based theme grouping analysis ([[--suggest-groups]]) to identify similar
themes that could be treated together.

@

\paragraph{Theme selection helpers.}
We factor out theme resolution logic into helper functions to keep the main
command body clean and to enable reuse of theme selection in future commands.

When users accept merged theme suggestions (for example, merging
\enquote{security} and \enquote{authentication} into \enquote{Security \& Auth}),
the merged name does not correspond to any actual paper tag.
To handle this, [[_resolve_themes]] returns both the selected theme names and a
mapping of any accepted groupings.
This mapping is then passed to [[generate_literature_synthesis]], which uses it
to combine papers from all constituent themes under the merged name.

<<llm command helpers>>=
def _select_themes_interactively(
    theme_counts: dict[str, int],
    console: Console,
) -> list[str] | None:
    """Display checklist of themes and let user select which to include.

    Args:
        theme_counts: Dict mapping theme names to paper counts.
        console: Rich console for output.

    Returns:
        List of selected theme names, or None if selection cancelled.
    """
    import questionary

    if not theme_counts:
        console.print("[yellow]No themes found in kept papers.[/yellow]")
        return None

    # Build choices sorted by paper count (descending), then alphabetically
    sorted_themes = sorted(
        theme_counts.items(),
        key=lambda x: (-x[1], x[0]),
    )
    choices = [
        questionary.Choice(
            title=f"{theme} ({count} paper{'s' if count != 1 else ''})",
            value=theme,
            checked=True,  # All selected by default
        )
        for theme, count in sorted_themes
    ]

    selected = questionary.checkbox(
        message="Select themes to include in synthesis:",
        choices=choices,
    ).ask()

    return selected if selected else None


def _resolve_themes(
    session,
    themes_option: list[str] | None,
    interactive: bool,
    suggest_groups: bool,
    model_id: str | None,
    console: Console,
) -> tuple[list[str] | None, dict[str, list[str]] | None]:
    """Determine which themes to include in synthesis.

    Handles the --themes, --interactive, and --suggest-groups options.

    Args:
        session: The review session.
        themes_option: List of themes from --themes option, or None.
        interactive: Whether --interactive flag was set.
        suggest_groups: Whether --suggest-groups flag was set.
        model_id: LLM model ID for theme grouping.
        console: Rich console for output.

    Returns:
        Tuple of (selected_themes, theme_groupings).
        theme_groupings maps merged names to constituent original themes.
    """
    from scholar.llm_review import get_session_theme_counts

    theme_counts = get_session_theme_counts(session)

    # If --themes was specified, validate (and optionally interactively narrow)
    if themes_option:
        available = set(theme_counts.keys())
        requested = set(themes_option)
        invalid = requested - available

        if invalid:
            console.print(
                f"[yellow]Warning: Unknown themes ignored: "
                f"{', '.join(sorted(invalid))}[/yellow]"
            )

        valid_themes = [t for t in themes_option if t in available]
        if not valid_themes:
            console.print(
                "[red]None of the specified themes exist. "
                f"Available: {', '.join(sorted(available))}[/red]"
            )
            raise typer.Exit(1)

        if not interactive:
            return valid_themes, None

        # Restrict counts to the provided themes for interactive selection
        restricted_counts = {
            t: theme_counts[t] for t in valid_themes if t in theme_counts
        }

        groupings: dict[str, list[str]] | None = None
        if suggest_groups and len(restricted_counts) > 1:
            restricted_counts, groupings = _apply_theme_groupings(
                theme_counts=restricted_counts,
                research_context=session.research_context,
                model_id=model_id,
                console=console,
            )
            if not groupings:
                groupings = None

        selected = _select_themes_interactively(restricted_counts, console)
        return selected, groupings

    # If --interactive, show checklist
    if interactive:
        if not theme_counts:
            console.print(
                "[yellow]No themes assigned to kept papers. "
                "Synthesis will include all papers without theme structure.[/yellow]"
            )
            return None, None

        # Optionally run theme grouping analysis
        groupings = None
        if suggest_groups and len(theme_counts) > 1:
            theme_counts, groupings = _apply_theme_groupings(
                theme_counts=theme_counts,
                research_context=session.research_context,
                model_id=model_id,
                console=console,
            )
            if not groupings:
                groupings = None

        selected = _select_themes_interactively(theme_counts, console)
        return selected, groupings

    # Default: include all themes
    return None, None


def _apply_theme_groupings(
    theme_counts: dict[str, int],
    research_context: str | None,
    model_id: str | None,
    console: Console,
) -> tuple[dict[str, int], dict[str, list[str]]]:
    """Run LLM theme grouping analysis and apply accepted groupings.

    Args:
        theme_counts: Dict mapping theme names to paper counts.
        research_context: The research question context.
        model_id: LLM model to use.
        console: Rich console for output.

    Returns:
        Tuple of (updated_theme_counts, accepted_groupings).
        accepted_groupings maps merged names to original theme lists.
    """
    import questionary
    from scholar.llm_review import suggest_theme_groups

    console.print("[dim]Analyzing themes for potential groupings...[/dim]")

    try:
        result = suggest_theme_groups(
            theme_counts=theme_counts,
            research_context=research_context,
            model_id=model_id,
        )
    except ImportError as e:
        console.print(f"[yellow]Warning: {escape(str(e))}[/yellow]")
        return theme_counts, {}

    if not result.groups:
        console.print("[dim]No theme groupings suggested.[/dim]")
        return theme_counts, {}

    # Show the overall explanation
    console.print(f"\n[bold]Theme grouping analysis:[/bold]")
    console.print(f"  {escape(result.explanation)}\n")

    # Process each suggested group
    updated_counts = dict(theme_counts)
    accepted_groupings: dict[str, list[str]] = {}
    for group in result.groups:
        console.print(
            f"[bold]Suggested merge: {escape(group.merged_name)}[/bold]"
        )
        console.print(
            f"  Themes: {', '.join(escape(t) for t in group.themes)}"
        )
        console.print(f"  Reasoning: {escape(group.reasoning)}")

        accept = questionary.confirm(
            f"Accept this grouping?",
            default=True,
        ).ask()

        if accept:
            # Calculate combined paper count
            combined_count = sum(
                updated_counts.get(t, 0) for t in group.themes
            )
            # Remove original themes
            for t in group.themes:
                updated_counts.pop(t, None)
            # Add merged theme
            updated_counts[group.merged_name] = combined_count
            # Track the grouping for synthesis
            accepted_groupings[group.merged_name] = list(group.themes)
            console.print(
                f"  [green]Merged {len(group.themes)} themes → "
                f"{escape(group.merged_name)} ({combined_count} papers)[/green]\n"
            )
        else:
            console.print("  [dim]Skipped[/dim]\n")

    return updated_counts, accepted_groupings
@

