\paragraph{Session name completion}
For commands that operate on saved sessions, we complete from the stored
session names.
This requires dynamically loading the session list:

<<completion functions>>=
def complete_session_name(incomplete: str) -> list[str]:
    """Provide shell completion for session names."""
    from scholar.review import list_sessions
    try:
        sessions = list_sessions()
        return [s["name"] for s in sessions if s["name"].startswith(incomplete)]
    except Exception:
        return []


def complete_model(incomplete: str) -> list[str]:
    """Provide shell completion for installed llm models."""
    try:
        import llm
    except Exception:
        return []

    try:
        model_ids = [m.model_id for m in llm.get_models()]
    except Exception:
        return []

    # Keep ordering stable and drop duplicates.
    seen: set[str] = set()
    results: list[str] = []
    for model_id in model_ids:
        if model_id in seen:
            continue
        seen.add(model_id)
        if model_id.startswith(incomplete):
            results.append(model_id)

    return results
@

\paragraph{Paper ID completion}
For commands that reference papers with notes, we complete from stored
paper IDs:

<<completion functions>>=
def complete_paper_id(incomplete: str) -> list[str]:
    """Provide shell completion for paper IDs with notes."""
    from scholar.notes import list_papers_with_notes
    try:
        notes = list_papers_with_notes()
        return [n.paper_id for n in notes if n.paper_id.startswith(incomplete)]
    except Exception:
        return []
@

The [[prov found-via]] command traces papers through saved review sessions
rather than through standalone notes, so its completion draws paper IDs from
the sessions instead.  A paper can appear in several sessions, so we deduplicate
as we go and swallow any load error---completion must never raise:

<<completion functions>>=
def complete_session_paper_id(incomplete: str) -> list[str]:
    """Provide shell completion for paper IDs in saved sessions."""
    from scholar.review import list_sessions, load_session
    results: list[str] = []
    seen: set[str] = set()
    try:
        for meta in list_sessions():
            session = load_session(meta["name"])
            if session is None:
                continue
            for decision in session.decisions:
                pid = decision.paper.id
                if pid not in seen and pid.startswith(incomplete):
                    seen.add(pid)
                    results.append(pid)
    except Exception:
        return []
    return results
@

