            "@article{bob2020,\n"
            "  title = {T},\n"
            "}\n"
        )
        entries = _parse_bib_entries(text)
        assert entries[0].prov_blocks == []
@

\subsection{Rendering provenance blocks for a [[.bib]]}

Going the other way, we render a paper's stored blocks as comment lines headed by
the \emph{entry's} bibkey --- not the key remembered in the note --- so every
emitted block agrees with the entry it sits above even if the two were ever
keyed differently.

<<formatter classes>>=
def _render_prov_blocks(key: str, blocks: list) -> str:
    """Render provenance ``(key, fields)`` blocks as ``%`` comment lines."""
    rendered = []
    for _, fields in blocks:
        lines = [f"% === provenance: {key} ==="]
        lines += [f"% {name}: {value}" for name, value in fields.items()]
        rendered.append("\n".join(lines))
    return "\n".join(rendered)
@

The rewriter walks the entries in order, copying untouched text verbatim.  When
a paper has stored blocks it rewrites the entry's provenance region: it keeps
any non-provenance comment lines (via [[_kept_comment_lines]]), drops the old
blocks, and emits the regenerated ones just above the entry.  When a paper has
no blocks the entry --- and any comment already there --- is left exactly as
found, so export never destroys a block it cannot replace.

<<formatter classes>>=
def _rewrite_with_blocks(text: str, entries: list, blocks_for) -> tuple:
    """Rewrite ``text`` so each entry is preceded by ``blocks_for(entry)``.

    Returns ``(new_text, count)`` where ``count`` is the number of entries
    whose provenance region was written.  Entries with no blocks are left
    untouched, as are any non-provenance comments above an entry.
    """
    lines = text.split("\n")
    out: list = []
    cursor = 0
    count = 0
    for entry in entries:
        blocks = blocks_for(entry)
        if blocks:
            region = (
                entry.comment_start
                if entry.comment_start is not None else entry.entry_start
            )
            out.extend(lines[cursor:region])
            if entry.comment_start is not None:
                out.extend(_kept_comment_lines(
                    lines[entry.comment_start:entry.entry_start]
                ))
            out.append(_render_prov_blocks(entry.key, blocks))
            out.extend(lines[entry.entry_start:entry.entry_end + 1])
            count += 1
        else:
            out.extend(lines[cursor:entry.entry_end + 1])
        cursor = entry.entry_end + 1
    out.extend(lines[cursor:])
    return "\n".join(out), count
@

We verify that a stored block is inserted above an entry that had none, and that
an entry whose paper has no block is passed through untouched:

<<test functions>>=
class TestProvRewrite:
    """Tests for rewriting a .bib with stored provenance blocks."""

    def test_inserts_block_above_entry(self):
        """A paper's block is inserted above its bare entry."""
        text = "@article{a2024,\n  title = {T},\n}\n"
        entries = _parse_bib_entries(text)
        blocks = [("ignored", {"CLAIM": "c"})]
        new_text, count = _rewrite_with_blocks(
            text, entries, lambda e: blocks
        )
        assert count == 1
        assert "% === provenance: a2024 ===" in new_text
        assert "% CLAIM: c" in new_text
        assert new_text.index("% CLAIM") < new_text.index("@article")

    def test_passes_through_when_no_blocks(self):
        """An entry with no stored block is left unchanged."""
        text = "@article{a2024,\n  title = {T},\n}\n"
        entries = _parse_bib_entries(text)
        new_text, count = _rewrite_with_blocks(text, entries, lambda e: [])
        assert count == 0
        assert new_text == text

    def test_preserves_non_provenance_comment(self):
        """A plain comment above an entry survives a block rewrite."""
        text = (
            "% TODO: double-check this reference\n"
            "% === provenance: a2024 ===\n"
            "% CLAIM: old\n"
            "@article{a2024,\n  title = {T},\n}\n"
        )
        entries = _parse_bib_entries(text)
        blocks = [("a2024", {"CLAIM": "new"})]
        new_text, count = _rewrite_with_blocks(
            text, entries, lambda e: blocks
        )
        assert "% TODO: double-check this reference" in new_text
        assert "% CLAIM: new" in new_text
        assert "% CLAIM: old" not in new_text
        # The kept comment stays above the regenerated block.
        assert new_text.index("% TODO") < new_text.index("% CLAIM: new")
