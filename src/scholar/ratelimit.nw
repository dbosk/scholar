<<test functions>>=
class TestTimeHelpers:
    """Tests for the time helper functions."""

    def test_next_daily_reset_is_next_utc_midnight(self, clock):
        reset = next_daily_reset()
        assert reset > clock["now"]
        assert reset - clock["now"] <= 24 * 3600
        from datetime import datetime, timezone
        dt = datetime.fromtimestamp(reset, tz=timezone.utc)
        assert (dt.hour, dt.minute, dt.second) == (0, 0, 0)

