<<rate limiter methods>>=
def status(self) -> QuotaStatus:
    """Return a display snapshot of limits, usage, and availability."""
    state = load_state(self.name)
    reset_at = state.get("reset_at")
    if reset_at is None and self.limits.daily:
        reset_at = next_daily_reset()
    return QuotaStatus(
        name=self.name,
        limits=self.limits,
        day_count=state["day_count"],
        remaining=state.get("remaining"),
        reset_at=reset_at,
        availability=_availability(state, self.limits),
    )
