\subsection{Formatting reset times for users}

The skip warning must be actionable: \enquote{resets 02:00 (in 14h37m)}
tells the user both when to retry and how long that is from now.
The absolute time is shown in the user's local timezone---that is the
clock they will look at---while all internal bookkeeping stays in epoch
seconds.

<<time helpers>>=
def format_retry(retry_at: float | None) -> str:
    """Format an epoch timestamp as `HH:MM (in XhYYm)` local time.

    Returns `"later"` if the timestamp is unknown.
    """
    if retry_at is None:
        return "later"
    delta = max(0, int(retry_at - _now()))
    when = datetime.fromtimestamp(retry_at).strftime("%H:%M")
    hours, remainder = divmod(delta, 3600)
    minutes = remainder // 60
    if hours:
        relative = f"{hours}h{minutes:02d}m"
    elif minutes:
        relative = f"{minutes}m"
    else:
        relative = f"{delta}s"
    return f"{when} (in {relative})"
@

<<test functions>>=
class TestFormatRetry:
    """Tests for `format_retry`."""

    def test_unknown_is_later(self, clock):
        assert format_retry(None) == "later"

    def test_relative_part(self, clock):
        text = format_retry(clock["now"] + 2 * 3600 + 5 * 60)
        assert "(in 2h05m)" in text
        text = format_retry(clock["now"] + 5 * 60)
        assert "(in 5m)" in text
        text = format_retry(clock["now"] + 30)
        assert "(in 30s)" in text
