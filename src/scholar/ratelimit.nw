class TestStateStore:
    """Tests for loading and saving rate-limit state."""

    def test_fresh_state_when_no_file(self, clock):
        state = load_state("nobody")
        assert state["day_count"] == 0
        assert state["cooldown_until"] is None

    def test_fail_open_on_garbage(self, clock):
        _state_file("broken").write_text("not json {")
        state = load_state("broken")
        assert state["day_count"] == 0

    def test_fail_open_on_unknown_version(self, clock):
        state = _fresh_state("future")
        state["version"] = 999
        state["day_count"] = 150
        save_state("future", state)
        assert load_state("future")["day_count"] == 0

    def test_day_roll_resets_count_not_cooldown(self, clock):
        state = _fresh_state("ieee")
        state["day_count"] = 200
        state["cooldown_until"] = clock["now"] + 25 * 3600
        state["cooldown_reason"] = "rate limited"
        save_state("ieee", state)
        clock["now"] += 24 * 3600
        rolled = load_state("ieee")
        assert rolled["day_count"] == 0
        assert rolled["cooldown_until"] == state["cooldown_until"]

    def test_expired_cooldown_dropped(self, clock):
        state = _fresh_state("ieee")
        state["cooldown_until"] = clock["now"] + 10
        save_state("ieee", state)
        clock["now"] += 11
        assert load_state("ieee")["cooldown_until"] is None

    def test_atomic_save_leaves_no_temp_files(self, clock):
        save_state("ieee", _fresh_state("ieee"))
        files = sorted(p.name for p in get_state_dir().iterdir())
        assert files == ["ieee.json"]

    def test_last_writer_wins(self, clock):
        """Concurrent read-modify-write loses increments; last save wins.

        This pins the documented trade-off: no file locking, bounded
        undercount, corrected by the provider's own rejections.
        """
        first = load_state("ieee")
        second = load_state("ieee")
        first["day_count"] = 1
        save_state("ieee", first)
        second["day_count"] = 5
        save_state("ieee", second)
        assert load_state("ieee")["day_count"] == 5
