    assert papers[0].sources == ["hal"]

  @pytest.mark.integration
  def test_real_check(self):
    """A live health probe reports ok (or a transient rate limit)."""
    provider = HALProvider()
    try:
      status, _message = provider.check()
    except Exception as e:
      pytest.skip(f"HAL API unavailable: {e}")
    assert status in (HEALTH_OK, HEALTH_RATE_LIMITED)
