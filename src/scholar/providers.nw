<<provider group test methods>>=
def test_preprints_group_members_registered(self):
  """Every member of the preprints group is a registered provider."""
  for name in PROVIDER_GROUPS["preprints"]:
    assert get_provider(name) is not None, f"{name} not registered"

def test_expand_preprints_group(self):
  """The preprints group expands to all its members."""
  expanded = expand_provider_names(["preprints"])
  assert expanded == list(PROVIDER_GROUPS["preprints"])

def test_expand_mixed_names_keeps_order_and_dedups(self):
  """Explicit names mix with groups; duplicates are dropped."""
  expanded = expand_provider_names(["s2", "preprints", "arxiv"])
  assert expanded[0] == "s2"
  assert expanded.count("arxiv") == 1
  assert set(PROVIDER_GROUPS["preprints"]) <= set(expanded)

def test_expand_is_idempotent(self):
  """Expanding an already-expanded list changes nothing."""
  once = expand_provider_names(["preprints"])
  assert expand_provider_names(once) == once

def test_expand_warns_on_unknown_name(self, caplog):
  """An unknown name passes through but logs a warning."""
  with caplog.at_level(logging.WARNING, logger="scholar.providers"):
    expanded = expand_provider_names(["openalx"])
  assert "openalx" in expanded
  assert "openalx" in caplog.text

def test_group_names_do_not_shadow_providers(self):
  """No group name collides with a registered provider name."""
  for group in PROVIDER_GROUPS:
    assert group not in PROVIDERS
