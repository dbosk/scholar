def check(self) -> tuple[str, str]:
    """Probe the works endpoint with a one-result source-pinned query."""
    self._wait_for_rate_limit()
    params = {
        "filter": f"locations.source.id:{self.source_id}",
        "per-page": 1,
    }
    if pyalex.config.email:
        params["mailto"] = pyalex.config.email
    response = requests.get(OPENALEX_API_URL, params=params, timeout=30)
    return classify_check_response(response, authenticated=False)
