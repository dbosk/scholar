class TestEnrichSnowballPapers:
    """Tests for enrich_snowball_papers function."""

    def test_enriches_papers_without_titles(self):
        """Papers without titles get enriched via DOI lookup."""
        papers = [
            Paper(title="", authors=[], doi="10.1/missing"),
            Paper(title="Has Title", authors=[], doi="10.1/complete"),
        ]

        mock_provider = MagicMock()
        mock_provider.get_paper_by_doi.return_value = Paper(
            title="Resolved Title",
            authors=["Author"],
            doi="10.1/missing",
            abstract="Abstract",
            sources=["s2"]
        )

        with patch("scholar.enrich.get_provider", return_value=mock_provider):
            result = enrich_snowball_papers(papers)

        assert len(result) == 2
        assert result[0].title == "Resolved Title"
        assert result[1].title == "Has Title"

    def test_filters_out_papers_without_titles(self):
        """Papers that still lack titles after enrichment are excluded."""
        papers = [
            Paper(title="", authors=[], doi="10.1/unresolvable"),
            Paper(title="Has Title", authors=[]),
        ]

        mock_provider = MagicMock()
        mock_provider.get_paper_by_doi.return_value = None  # Can't resolve

        with patch("scholar.enrich.get_provider", return_value=mock_provider):
            result = enrich_snowball_papers(papers)

        # Only the paper with title remains
        assert len(result) == 1
        assert result[0].title == "Has Title"

    def test_handles_papers_without_dois(self):
        """Papers without DOIs are kept if they have titles."""
        papers = [
            Paper(title="No DOI", authors=[]),
            Paper(title="", authors=[]),  # No DOI, no title - excluded
        ]

        result = enrich_snowball_papers(papers)

        assert len(result) == 1
        assert result[0].title == "No DOI"
