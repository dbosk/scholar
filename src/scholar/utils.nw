class TestPaperIdentifierHelpers:
    """Tests for paper identifier helper functions."""

    def test_legacy_hash_paper_id_matches_paper_id_without_doi(self):
        paper = Paper(title="A Title", authors=["Ada Lovelace"], doi=None)
        assert legacy_hash_paper_id(paper.title, paper.authors) == paper.id

    def test_arxiv_id_from_url_abs_strips_version(self):
        assert arxiv_id_from_url("https://arxiv.org/abs/2401.12345v2") == "2401.12345"

    def test_arxiv_id_from_url_pdf_strips_version_and_extension(self):
        assert (
            arxiv_id_from_url("https://arxiv.org/pdf/2401.12345v1.pdf")
            == "2401.12345"
        )

    def test_arxiv_id_from_url_old_style(self):
        assert (
            arxiv_id_from_url("https://arxiv.org/abs/hep-th/9901001v2")
            == "hep-th/9901001"
        )

    def test_arxiv_doi_from_url(self):
        assert (
            arxiv_doi_from_url("http://arxiv.org/abs/2401.12345v1")
            == "10.48550/arXiv.2401.12345"
        )

    def test_derive_arxiv_doi_only_when_missing_doi(self):
        paper = Paper(
            title="X",
            authors=["A"],
            doi=None,
            url="https://arxiv.org/abs/2401.12345v1",
        )
        assert derive_arxiv_doi(paper) == "10.48550/arXiv.2401.12345"

        paper2 = Paper(
            title="X",
            authors=["A"],
            doi="10.9999/example",
            url="https://arxiv.org/abs/2401.12345v1",
        )
        assert derive_arxiv_doi(paper2) is None
